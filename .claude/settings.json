{
  "permissions": {
    "allow": [
      "Bash(sb:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./sources/*.md)",
      "Edit(./sources/*.meta.json)",
      "Edit(./sources/inbox/**)",
      "Edit(./index.md)",
      "Edit(./log/**)",
      "Edit(./.sb/**)",
      "Edit(./.githooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)"
    ],
    "ask": [
      "Edit(./CONVENTIONS.md)",
      "Bash(sb clip *--allow-local*)",
      "Bash(sb uninstall *--apply*)"
    ]
  }
}
